    "n_patterns": {
      "rule_id": "max_one_or_int_capacity_ratio_times_n_bits",
      "capacity_ratio": 0.3
    }
  },
  "models": [
    {
      "procedure_id": "hopfield_synchronous",
      "source": "src.hopfield.Hopfield",
      "parameters": {
        "steps": 10
      },
      "training": {
        "operation": "train"
      },
      "recall": {
        "operation": "recall_timed",
        "returns": ["pattern", "wall_time_per_bit"]
      }
    },
    {
      "procedure_id": "qam_rot_fullbatch",
      "source": "experiments.noise_robustness_sweep.QAM",
      "parameters": {
        "depth_argument": 6,
        "depth_used_rule_id": "min_depth_argument_and_n_bits",
        "train_steps": 1,
        "lr": 0.05
      },
      "rng": {
        "family": "legacy_global",
        "constructor_reseeds": true,
        "reseed_value": 42,
        "seed_policy_id": "legacy_global_trial_seed_then_qam_constructor_reseed_42"
      },
      "training": {
        "operation": "train"
      },
      "recall": {
        "operation": "recall",
        "returns": ["pattern", "wall_time_per_bit"]
      }
    }
  ],
  "perturbation": {
    "procedure_id": "bernoulli",
    "levels": [0.0],
    "when": "each_stored_pattern_after_that_model_trains"
  },
  "metrics": ["batch_recall", "gaussian_ci_population"],
  "timings": ["train_time_seconds", "mean_recall_time_per_bit"],
  "seeds": {
    "trial_seeds": [0, 1],
    "trial_count": 2,
    "seed_policy_id": "legacy_global_trial_seed_then_qam_constructor_reseed_42"
  },
  "declared_cell_count": 2,
  "execution": {
    "process_model": "single_process",
    "max_cells": 4,
    "max_train_steps": 5,
    "caps_are_authoritative_in": "benchmark.protocols.noise_robustness_sweep"
  },
  "output": {
    "destination": "runs/noise_robustness_sweep_smoke",
    "overwrite_archived_results": false,
